#include <stdio.h>

int main() {
    int n, i;
    if (scanf("%d", &n) != 1) return 0;
    int arr[n];
    long long total_sum = 0;
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        total_sum += arr[i];
    }

    long long left_sum = 0;
    int pivot = -1;
    for (i = 0; i < n; i++) {
        if (left_sum == total_sum - left_sum - arr[i]) {
            pivot = i;
            break;
        }
        left_sum += arr[i];
    }

    printf("%d\n", pivot);
    return 0;
}
